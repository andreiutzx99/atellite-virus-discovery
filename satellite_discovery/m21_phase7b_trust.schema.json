{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M21 Phase 7B external trust-root bundle",
  "oneOf": [
    { "$ref": "#/$defs/anchor" },
    { "$ref": "#/$defs/registry" },
    { "$ref": "#/$defs/checkpoint" },
    { "$ref": "#/$defs/bundle" }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "anchor": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "anchor_id", "key_id", "public_key_ed25519", "key_fingerprint_sha256", "authority"],
      "properties": {
        "schema_version": { "const": "m21-phase7b-trust-anchor-v1" },
        "anchor_id": { "type": "string", "minLength": 1 },
        "key_id": { "type": "string", "minLength": 1 },
        "public_key_ed25519": { "type": "string", "contentEncoding": "base64" },
        "key_fingerprint_sha256": { "$ref": "#/$defs/sha256" },
        "authority": { "type": "string", "minLength": 1 }
      }
    },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["identity_id", "display_name", "organization", "key_id", "public_key_ed25519", "key_fingerprint_sha256", "identity_class", "roles", "scopes", "valid_from", "valid_until", "revoked", "identity_verification", "enrollment_approvals", "rotation"],
      "properties": {
        "identity_id": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "organization": { "type": "string", "minLength": 1 },
        "key_id": { "type": "string", "minLength": 1 },
        "public_key_ed25519": { "type": "string", "contentEncoding": "base64" },
        "key_fingerprint_sha256": { "$ref": "#/$defs/sha256" },
        "identity_class": { "enum": ["HUMAN", "SYNTHETIC"] },
        "roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["reviewer", "custodian", "trust_admin"] } },
        "scopes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "valid_from": { "type": "string", "format": "date-time" },
        "valid_until": { "type": "string", "format": "date-time" },
        "revoked": { "type": "boolean" },
        "identity_verification": {
          "type": "object", "additionalProperties": false,
          "required": ["method", "evidence_sha256", "authority"],
          "properties": {
            "method": { "type": "string", "minLength": 1 },
            "evidence_sha256": { "$ref": "#/$defs/sha256" },
            "authority": { "type": "string", "minLength": 1 }
          }
        },
        "enrollment_approvals": { "type": "array", "items": { "type": "object" } },
        "rotation": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object", "additionalProperties": false,
              "required": ["previous_key_fingerprint_sha256", "previous_public_key_ed25519", "continuity_signature_ed25519"],
              "properties": {
                "previous_key_fingerprint_sha256": { "$ref": "#/$defs/sha256" },
                "previous_public_key_ed25519": { "type": "string", "contentEncoding": "base64" },
                "continuity_signature_ed25519": { "type": "string", "contentEncoding": "base64" }
              }
            }
          ]
        }
      }
    },
    "registry": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "registry_id", "generation", "previous_checkpoint_sha256", "issued_at", "expires_at", "identities"],
      "properties": {
        "schema_version": { "const": "m21-phase7b-trust-registry-v1" },
        "registry_id": { "type": "string", "minLength": 1 },
        "generation": { "type": "integer", "minimum": 1 },
        "previous_checkpoint_sha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
        "issued_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "identities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/identity" } }
      }
    },
    "checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "registry_id", "generation", "registry_sha256", "previous_checkpoint_sha256", "issued_at", "signature_ed25519"],
      "properties": {
        "schema_version": { "const": "m21-phase7b-trust-state-checkpoint-v1" },
        "registry_id": { "type": "string", "minLength": 1 },
        "generation": { "type": "integer", "minimum": 1 },
        "registry_sha256": { "$ref": "#/$defs/sha256" },
        "previous_checkpoint_sha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
        "issued_at": { "type": "string", "format": "date-time" },
        "signature_ed25519": { "type": "string", "contentEncoding": "base64" }
      }
    },
    "bundle": {
      "type": "object", "additionalProperties": false,
      "required": ["registry", "state_checkpoint", "anchor_signature"],
      "properties": {
        "registry": { "$ref": "#/$defs/registry" },
        "state_checkpoint": { "$ref": "#/$defs/checkpoint" },
        "anchor_signature": { "type": "string", "contentEncoding": "base64" }
      }
    }
  }
}

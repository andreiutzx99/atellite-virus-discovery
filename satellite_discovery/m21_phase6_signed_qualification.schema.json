{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M21 Phase 6 signed synthetic control qualification",
  "type": "object",
  "additionalProperties": false,
  "required": ["content", "approvals"],
  "properties": {
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase4_qualification", "control_id", "sample_ids", "control_class", "evaluation_status", "scoring_eligibility", "exclusion_reason", "study_id", "replicate_group", "evidence_sha256"],
      "properties": {
        "phase4_qualification": {"$ref": "m21_control_qualification.schema.json"},
        "control_id": {"type": "string", "minLength": 1},
        "sample_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^BLD-[A-F0-9]{24}$"}},
        "control_class": {"enum": ["POSITIVE", "NEGATIVE", "HELPER_POSITIVE", "HELPER_NEGATIVE"]},
        "evaluation_status": {"enum": ["EVALUABLE", "PENDING", "UNEVALUABLE"]},
        "scoring_eligibility": {"type": "boolean"},
        "exclusion_reason": {"type": ["string", "null"]},
        "study_id": {"type": "string", "minLength": 1},
        "replicate_group": {"type": "string", "minLength": 1},
        "evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "approvals": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "approval_id", "reviewer_id", "approved_at", "expires_at", "evidence_sha256", "manifest_sha256", "key_id", "signature_ed25519"],
        "properties": {
          "status": {"const": "APPROVED"},
          "approval_id": {"type": "string", "pattern": "^APR-[A-Z0-9]{12}$"},
          "reviewer_id": {"type": "string", "pattern": "^REV-[A-Z0-9]{8}$"},
          "approved_at": {"type": "string", "format": "date-time"},
          "expires_at": {"type": "string", "format": "date-time"},
          "evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "key_id": {"type": "string", "pattern": "^KEY-[A-Z0-9]{10}$"},
          "signature_ed25519": {"type": "string", "contentEncoding": "base64"}
        }
      }
    }
  }
}

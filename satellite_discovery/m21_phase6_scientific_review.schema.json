{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M21 Phase 6 scientific review of reference-exclusion policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_version", "min_identity", "min_query_coverage", "alignment_model", "sequence_completeness_assumptions", "reference_panel_exclusion_scope", "known_false_exclusion_risks", "known_missed_exclusion_risks", "reviewer_evidence_sha256", "decision", "limitations", "expires_at", "policy_sha256", "reference_sha256"],
  "properties": {
    "policy_version": {"type": "string", "minLength": 1},
    "min_identity": {"type": "number", "minimum": 0, "maximum": 1},
    "min_query_coverage": {"type": "number", "minimum": 0, "maximum": 1},
    "alignment_model": {"type": "string", "minLength": 1},
    "sequence_completeness_assumptions": {"type": "string", "minLength": 1},
    "reference_panel_exclusion_scope": {"type": "string", "minLength": 1},
    "known_false_exclusion_risks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "known_missed_exclusion_risks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "reviewer_evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "decision": {"enum": ["APPROVED", "REJECTED", "INCOMPLETE"]},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "expires_at": {"type": "string", "format": "date-time"},
    "policy_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reference_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}

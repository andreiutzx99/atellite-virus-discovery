{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M21 Phase 6 authenticated governance transition receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt", "approvals"],
  "properties": {
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_state",
        "requested_state",
        "evidence_category",
        "verified_artifact_digests",
        "verification_result",
        "previous_transition_sha256"
      ],
      "properties": {
        "current_state": {
          "enum": [
            "PREPARED",
            "QUALIFIED",
            "REFERENCE_APPROVED",
            "BLINDED_ANALYSIS_VERIFIED",
            "UNBLINDING_AUTHORISED"
          ]
        },
        "requested_state": {
          "enum": [
            "QUALIFIED",
            "REFERENCE_APPROVED",
            "BLINDED_ANALYSIS_VERIFIED",
            "UNBLINDING_AUTHORISED",
            "SYNTHETIC_SCORING_COMPLETE"
          ]
        },
        "evidence_category": {
          "enum": [
            "CONTROL_QUALIFICATION",
            "REFERENCE_GOVERNANCE",
            "BLINDED_ANALYSIS",
            "UNBLINDING_AUTHORIZATION",
            "SYNTHETIC_SCORING"
          ]
        },
        "verified_artifact_digests": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "verification_result": {"const": "PASS"},
        "previous_transition_sha256": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          ]
        }
      }
    },
    "approvals": {
      "$ref": "m21_phase6_signed_qualification.schema.json#/properties/approvals"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M21 Phase 5 control scoring eligibility",
  "type": "object",
  "additionalProperties": false,
  "required": ["control_id", "sample_ids", "control_class", "evaluation_status", "independently_reviewed", "scoring_eligibility", "exclusion_reason", "study_id", "replicate_group", "evidence_strength", "sensitivity_status", "review_evidence_sha256", "reviewer_ids", "qualification_sha256"],
  "properties": {
    "control_id": {"type": "string", "pattern": "^CTL-[A-Z0-9]{10}$"},
    "sample_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^BLD-[A-F0-9]{24}$"}},
    "control_class": {"enum": ["POSITIVE", "NEGATIVE", "HELPER_POSITIVE", "HELPER_NEGATIVE"]},
    "evaluation_status": {"enum": ["EVALUABLE", "UNEVALUABLE", "PENDING"]},
    "independently_reviewed": {"type": "boolean"},
    "scoring_eligibility": {"type": "boolean"},
    "exclusion_reason": {"type": ["string", "null"]},
    "study_id": {"type": "string", "minLength": 1},
    "replicate_group": {"type": "string", "minLength": 1},
    "evidence_strength": {"enum": ["HIGH", "MODERATE", "LIMITED", "PENDING"]},
    "sensitivity_status": {"enum": ["ADEQUATE", "LIMITED", "UNKNOWN", "NOT_APPLICABLE"]},
    "review_evidence_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "reviewer_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^REV-[A-Z0-9]{8}$"}},
    "qualification_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}

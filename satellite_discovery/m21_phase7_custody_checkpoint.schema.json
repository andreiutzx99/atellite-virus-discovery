{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M21 Phase 7 independently retained custody checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset_id", "chain_id", "event_count", "event_sha256", "sequence", "created_at", "previous_checkpoint_sha256", "trust_store_identity", "approval"],
  "properties": {
    "dataset_id": {"type": "string", "minLength": 1},
    "chain_id": {"type": "string", "pattern": "^CHAIN-SYNTH-[A-Z0-9]{2,20}$"},
    "event_count": {"type": "integer", "minimum": 1},
    "event_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sequence": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "previous_checkpoint_sha256": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[a-f0-9]{64}$"}]},
    "trust_store_identity": {"type": "string", "minLength": 1},
    "approval": {"$ref": "m21_benchmark_manifest.schema.json#/$defs/approval"}
  }
}
